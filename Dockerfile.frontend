# Fase 1: Build dell'applicazione frontend (Vite con Yarn)
# Usiamo l'immagine Node.js LTS (Long Term Support) come suggerito dal libro.
FROM node:lts AS builder

# Imposta la directory di lavoro all'interno del container.
WORKDIR /app/webui

# Abilita Corepack. Questo è fondamentale per gestire la versione di Yarn (v4) specificata nel tuo package.json.
RUN corepack enable

# Copia i file di configurazione del progetto per le dipendenze.
# Questo aiuta a sfruttare la cache di Docker: se package.json o yarn.lock non cambiano,
# Docker non reinstallerà le dipendenze.
COPY webui/package.json ./
COPY webui/yarn.lock ./

# Installa le dipendenze usando yarn.
# L'opzione --immutable è l'equivalente moderno di --frozen-lockfile per Yarn 4,
# e garantisce che il yarn.lock non venga modificato e che le dipendenze siano installate esattamente come specificato.
RUN yarn install

# Copia il resto del codice sorgente del frontend.
COPY webui/ .

# Esegui la build dell'applicazione frontend con Vite.
# Per un progetto Vite, il comando di build standard è 'yarn build' (o 'npm run build').
# Vite per default crea i file statici nella cartella 'dist'.
RUN yarn build

# Fase 2: Container finale per servire i file statici con Nginx
# Utilizziamo l'immagine Nginx "stable" come suggerito dal libro.
FROM nginx:stable

# Rimuovi la configurazione predefinita di Nginx per sostituirla con la nostra personalizzata.
RUN rm /etc/nginx/conf.d/default.conf

# Copia la configurazione personalizzata di Nginx.
# QUESTA È IMPORTANTE: CREA UN FILE 'nginx.conf' NELLA TUA CARTELLA RADICE DEL PROGETTO (~/Wasa-project-2024).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia i file statici costruiti dalla fase di 'builder' nella directory servita da Nginx.
# Vite genera i file statici nella cartella 'dist' all'interno della WORKDIR (/app/webui).
COPY --from=builder /app/webui/dist /usr/share/nginx/html

# Espone la porta 80, la porta predefinita per il traffico web HTTP che Nginx ascolta.
EXPOSE 80

# Come notato dal tuo libro, Nginx ha già un CMD predefinito per avviare il server,
# quindi non ne abbiamo bisogno uno esplicito qui.
# CMD ["nginx", "-g", "daemon off;"] # Non è necessario, Nginx lo fa già
