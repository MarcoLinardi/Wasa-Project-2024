# Fase 1: build Vue con Yarn
FROM node:lts AS builder

# Crea directory di lavoro nel container
WORKDIR /app

# Copia solo i file di configurazione e dipendenze
COPY webui/package.json webui/yarn.lock ./

# Abilita corepack per supportare yarn moderno
RUN corepack enable && yarn install

# Copia tutto il progetto Vue (dalla sottocartella)
COPY webui/ .

# Costruisci il frontend per produzione
RUN yarn build-prod

# Fase 2: usa Nginx per servire l'app
FROM nginx:stable

# Copia la build finale nel path di Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

